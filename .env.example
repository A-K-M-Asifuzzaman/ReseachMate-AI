# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=ResearchMate AI
ENVIRONMENT=development            # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Security / JWT ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=researchmate
POSTGRES_PASSWORD=researchmate
POSTGRES_DB=researchmate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL overrides the parts above if set (async driver):
# DATABASE_URL=postgresql+asyncpg://researchmate:researchmate@localhost:5432/researchmate

# ─── Qdrant (vector DB) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=researchmate_chunks

# ─── Neo4j (knowledge graph) ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchmate

# ─── LLM ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai               # openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini
LLM_MODEL_HEAVY=gpt-4o            # used for hard reasoning (KG extraction, agents)
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Embeddings ─────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                 # must match the model above
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# ─── Reranker ───────────────────────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Retrieval tuning ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20                # candidates pulled from each retriever
RERANK_TOP_N=6                    # chunks kept after reranking for the LLM
CHUNK_SIZE=1000                   # target chars per chunk
CHUNK_OVERLAP=150

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | s3
STORAGE_DIR=./storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=50
