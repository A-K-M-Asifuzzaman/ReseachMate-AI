# ── Production env (free-tier, OpenAI-only) ─────────────────────────────────
# Copy these into your host's env settings (Render dashboard, etc). Do NOT commit.

ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=true                 # create tables on first boot (or use Alembic)

# Your Vercel frontend URL(s), comma-separated (no trailing slash)
BACKEND_CORS_ORIGINS=https://your-app.vercel.app

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING

# ── OpenAI (the only paid service) ──
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MODEL_HEAVY=gpt-4o-mini             # keep KG extraction cheap

# ── Embeddings via OpenAI (no torch needed) ──
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                      # can set 512 to shrink vectors / storage
RERANKER_ENABLED=false

# ── Postgres (Supabase or Neon — free) ──
# Use the async driver form:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# ── Qdrant Cloud (free 1GB cluster) ──
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=researchmate_chunks

# ── Neo4j Aura (free) — only needed for the knowledge graph feature ──
NEO4J_URI=neo4j+s://YOUR-DB.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ── Storage (local disk on the host is fine for a demo) ──
STORAGE_BACKEND=local
STORAGE_DIR=./storage

RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25
